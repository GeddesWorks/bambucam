# BambuCam Configuration
# Copy to config/config.yaml and edit values.
# Secrets reference environment variables: ${VAR_NAME}

# Trigger source
trigger:
  type: gpio              # gpio | bambuddy | mock | bluetooth | mqtt
  gpio_pin: 17
  edge: falling           # falling for contact-closure triggers (CyberBrick)
  # Must be BELOW the trigger's pulse width, not above it. rpi-lgpio only
  # reports an edge once the level has been stable this long, so a debounce
  # longer than the pulse discards every trigger silently. CyberBrick pulses
  # ~100ms; measure yours with scripts/probe_gpio.py.
  debounce_ms: 20
  interval_seconds: 5     # mock trigger only: seconds between fake pulses
  # bambuddy trigger only: fire on each new layer Bambuddy reports.
  # No wiring, at the cost of up to poll_interval_seconds of jitter.
  bambuddy_url: http://192.168.1.90:8000
  bambuddy_printer_id: 1        # Jeff
  bambuddy_api_key: ${BAMBUDDY_API_KEY}
  poll_interval_seconds: 1.0

# Camera settings
camera:
  type: gphoto2_cli       # gphoto2_cli | gphoto2_native | mock
  timeout_seconds: 30
  retries: 3
  retry_delay_seconds: 2

# Capture storage
capture:
  base_dir: ./prints

# Video compilation
compile:
  fps: 30
  codec: libx264
  pixel_format: yuv420p

# Upload destination
upload:
  # nas | appwrite | none
  backend: nas
  nas:
    dir: /mnt/nas/BambuCam    # SMB share mounted via /etc/fstab
    mount_check: true         # refuse to write if the share is not mounted,
                              # which otherwise silently fills the SD card
  appwrite:
    endpoint: ${APPWRITE_ENDPOINT}
    project_id: ${APPWRITE_PROJECT_ID}
    api_key: ${APPWRITE_API_KEY}
    bucket_id: ${APPWRITE_BUCKET_ID}
  retry_attempts: 3
  retry_backoff_seconds: [5, 15, 45]

# Post-upload cleanup
cleanup:
  enabled: true
  delete_frames: true
  delete_video: true
  keep_meta: true
  keep_logs: true

# Logging
logging:
  level: INFO             # DEBUG | INFO | WARNING | ERROR
  format: json
  file: ./logs/bambucam.log

# Printer event source
# BambuCam listens for POST events on this port.
# Bambuddy sends webhook notifications here on print start/complete/fail.
# Also accepts native BambuCam payloads for custom integrations.
printer:
  provider: http          # http | mqtt | mock
  http:
    listen_port: 8420
